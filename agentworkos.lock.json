{
  "schema": "agentworkos.lock.v1",
  "manifest": "agentworkos.toml",
  "stack": {
    "name": "harzva-agentworkos-stack",
    "version": "0.1.0",
    "platforms": [
      "windows-x64",
      "darwin-arm64",
      "linux-x64"
    ],
    "codex_home": "~/.codex",
    "claude_home": "~/.claude",
    "default_profile": "safe-core"
  },
  "profiles": [
    {
      "name": "base",
      "description": "Terms, rules, and core AgentWorkOS inventory capability.",
      "packages": [
        "io.github.harzva.agentworkos.inventory",
        "io.github.harzva.agentworkos.terms",
        "io.github.harzva.agentworkos.rules"
      ],
      "repos": [
        "io.github.harzva.agentworkos",
        "io.github.harzva.agentworkos-stack"
      ]
    },
    {
      "name": "agents",
      "description": "Portable local task role cards for Codex and Claude Code.",
      "extends": [
        "base"
      ],
      "packages": [
        "local.agent.project-inventory",
        "local.agent.role-planner",
        "local.agent.quality-reviewer",
        "local.agent.release-manager"
      ]
    },
    {
      "name": "skills",
      "description": "Public-safe reusable skills used by the Harzva AgentOS workflow.",
      "extends": [
        "agents"
      ],
      "packages": [
        "io.github.just-agent.readme-design",
        "io.github.just-agent.app-preview-lab",
        "io.github.just-agent.appui-design",
        "io.github.harzva.design-md-flow",
        "io.github.harzva.readme-showcase-screenshot",
        "io.github.harzva.android-release-emulator-qa",
        "io.github.harzva.make-windows-silky"
      ]
    },
    {
      "name": "safe-core",
      "description": "Default public-safe Harzva AgentOS stack.",
      "extends": [
        "skills"
      ]
    },
    {
      "name": "windows-desktop",
      "description": "Windows desktop restore profile. Extends safe-core and keeps Windows-specific additions in ignored local overrides.",
      "extends": [
        "safe-core"
      ]
    },
    {
      "name": "mac-dev",
      "description": "macOS development restore profile. Extends safe-core; add macOS-only packages here when they become public-safe.",
      "extends": [
        "safe-core"
      ]
    },
    {
      "name": "linux-dev",
      "description": "Linux development restore profile. Extends safe-core; add Linux workstation packages here when they become public-safe.",
      "extends": [
        "safe-core"
      ]
    },
    {
      "name": "linux-server",
      "description": "Linux server restore profile. Extends safe-core and should stay CLI/server oriented.",
      "extends": [
        "safe-core"
      ]
    },
    {
      "name": "full",
      "description": "All packages and managed repo references declared by this public stack.",
      "packages": [
        "*"
      ],
      "repos": [
        "*"
      ]
    }
  ],
  "packages": [
